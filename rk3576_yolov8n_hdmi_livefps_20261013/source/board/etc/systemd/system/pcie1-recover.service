[Unit]
Description=RK3576 PCIe1 FPGA power and reset sequencing
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
ConditionPathExists=/sys/bus/platform/devices/2a210000.pcie

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pcie1-recover.sh
RemainAfterExit=yes
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
