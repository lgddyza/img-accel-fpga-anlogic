[Unit]
Description=Anlogic FPGA SGDMA driver
Requires=pcie1-recover.service
After=pcie1-recover.service
ConditionPathExists=/sys/bus/pci/devices/0000:21:00.0

[Service]
Type=oneshot
ExecStart=/sbin/modprobe anlogic_pci
ExecStop=/sbin/modprobe -r anlogic_pci
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
